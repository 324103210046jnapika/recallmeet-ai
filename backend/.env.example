# ==============================================================================
# RecallMeet AI - Environment Configuration Example
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Hindsight Memory Engine Configuration
# For local Docker instance: run `docker run -p 8888:8888 vectorize/hindsight`
# For Hindsight Cloud: https://api.hindsight.vectorize.io
HINDSIGHT_BASE_URL=http://localhost:8888
HINDSIGHT_API_KEY=
HINDSIGHT_BANK_ID=recallmeet-demo
HINDSIGHT_TIMEOUT=15

# Groq Cloud AI Configuration
# Obtain your key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Storage
DATA_DIR=data
